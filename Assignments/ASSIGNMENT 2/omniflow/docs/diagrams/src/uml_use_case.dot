digraph UC {graph [fontname="Helvetica" fontsize=15 bgcolor=white pad=0.2]; node [fontname="Helvetica" fontsize=14]; edge [fontname="Helvetica" fontsize=12];
rankdir=LR; splines=true; nodesep=0.25; ranksep=1.6;
"Customer" [shape=box style="rounded" label="<<actor>>\nCustomer" fillcolor=white];
"Picker" [shape=box style="rounded" label="<<actor>>\nPicker" fillcolor=white];
"Support agent" [shape=box style="rounded" label="<<actor>>\nSupport agent" fillcolor=white];
"Finance reviewer" [shape=box style="rounded" label="<<actor>>\nFinance reviewer" fillcolor=white];
"Store manager" [shape=box style="rounded" label="<<actor>>\nStore manager" fillcolor=white];
"Administrator" [shape=box style="rounded" label="<<actor>>\nAdministrator" fillcolor=white];
"Payment gateway (external)" [shape=box style="rounded" label="<<actor>>\nPayment gateway (external)" fillcolor=white];
"Courier API (external)" [shape=box style="rounded" label="<<actor>>\nCourier API (external)" fillcolor=white];
"Integration worker" [shape=box style="rounded" label="<<actor>>\nIntegration worker" fillcolor=white];
subgraph cluster_sys { label="OmniFlow system boundary"; style=solid; color=black; fontsize=12;
"UC01 Place order" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC01 Place order"];
"UC02 View own order and tracking" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC02 View own order and tracking"];
"UC04 Confirm pick" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC04 Confirm pick"];
"UC05 Dispatch order" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC05 Dispatch order"];
"UC13 Sync scanner events" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC13 Sync scanner events"];
"UC06 Look up order (masked)" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC06 Look up order\n(masked)"];
"UC07 Request return / refund" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC07 Request return / refund"];
"UC08 Approve or reject refund" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC08 Approve or reject refund"];
"UC10 View consolidated reports" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC10 View consolidated reports"];
"UC11 Configure regional policy" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC11 Configure regional policy"];
"UC14 Approve stock correction" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC14 Approve stock correction"];
"UC03 Confirm payment (gateway callback)" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC03 Confirm payment\n(gateway callback)"];
"UC12 Book shipment (worker)" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC12 Book shipment\n(worker)"];
"UC09 Execute refund (worker)" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC09 Execute refund\n(worker)"];
"UC15 Authenticate" [shape=ellipse style=filled fillcolor="#F2F2F2" label="UC15 Authenticate"];
}
"Customer" -> "UC01 Place order" [arrowhead=none];
"Customer" -> "UC02 View own order and tracking" [arrowhead=none];
"Picker" -> "UC04 Confirm pick" [arrowhead=none];
"Picker" -> "UC05 Dispatch order" [arrowhead=none];
"Picker" -> "UC13 Sync scanner events" [arrowhead=none];
"Support agent" -> "UC06 Look up order (masked)" [arrowhead=none];
"Support agent" -> "UC07 Request return / refund" [arrowhead=none];
"Finance reviewer" -> "UC08 Approve or reject refund" [arrowhead=none];
"Store manager" -> "UC10 View consolidated reports" [arrowhead=none];
"Store manager" -> "UC14 Approve stock correction" [arrowhead=none];
"Store manager" -> "UC08 Approve or reject refund" [arrowhead=none];
"Administrator" -> "UC11 Configure regional policy" [arrowhead=none];
"Administrator" -> "UC10 View consolidated reports" [arrowhead=none];
"Payment gateway (external)" -> "UC03 Confirm payment (gateway callback)" [arrowhead=none];
"Integration worker" -> "UC12 Book shipment (worker)" [arrowhead=none];
"Integration worker" -> "UC09 Execute refund (worker)" [arrowhead=none];
"UC12 Book shipment (worker)" -> "Courier API (external)" [arrowhead=none];
"UC09 Execute refund (worker)" -> "Payment gateway (external)" [arrowhead=none];
"UC01 Place order" -> "UC15 Authenticate" [style=dashed label="<<include>>"];
"UC06 Look up order (masked)" -> "UC15 Authenticate" [style=dashed label="<<include>>"];
"UC08 Approve or reject refund" -> "UC15 Authenticate" [style=dashed label="<<include>>"];
"UC11 Configure regional policy" -> "UC15 Authenticate" [style=dashed label="<<include>>"];
"UC09 Execute refund (worker)" -> "UC08 Approve or reject refund" [style=dashed label="<<include>>\n(approval first)"];
}