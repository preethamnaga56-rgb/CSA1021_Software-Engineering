digraph CLS {graph [fontname="Helvetica" fontsize=15 bgcolor=white pad=0.2]; node [fontname="Helvetica" fontsize=14]; edge [fontname="Helvetica" fontsize=12];
rankdir=TB; nodesep=0.5; ranksep=0.7;
User [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>User</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">role</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">region</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">email</TD></TR></TABLE>>];
Order [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>Order</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">state</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">total_cents</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">owner_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">region</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">policy_version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">cancel_reason</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">dispatch_due_at</TD></TR></TABLE>>];
OrderLine [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>OrderLine</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">sku</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">qty</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">unit_price_cents</TD></TR></TABLE>>];
StockItem [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>StockItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">sku</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">on_hand</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">reserved</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">CHECK on_hand &gt;= reserved &gt;= 0</TD></TR></TABLE>>];
Reservation [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>Reservation</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">order_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">sku</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">qty</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">expires_at</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD></TR></TABLE>>];
PaymentEvent [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>PaymentEvent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">gateway_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">event_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">order_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">amount_cents</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">UNIQUE(gateway_id,event_id)</TD></TR></TABLE>>];
RefundRequest [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>RefundRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">state</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">amount_cents</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">requested_by</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">approved_by</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">approval_policy_version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">attempts</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">version</TD></TR></TABLE>>];
IntegrationIntent [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>IntegrationIntent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">correlation_key (unique)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">purpose</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">attempts</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">external_id</TD></TR></TABLE>>];
AuditEvent [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>AuditEvent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">actor</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">action</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">order_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">at</TD></TR></TABLE>>];
RegionalPolicy [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>RegionalPolicy</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">region</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">tax_bps</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">shipping_cents</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">refund_limit_cents</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">return_days</TD></TR></TABLE>>];
ScanEvent [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E6E6E6"><B>ScanEvent</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0">node_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">event_id</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">sku</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">delta</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">observed_at</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">policy_version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">schema_version</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">stale</TD></TR></TABLE>>];
User -> Order [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
Order -> OrderLine [arrowhead=none taillabel="1" headlabel="1..*" labeldistance=1.8];
Order -> Reservation [arrowhead=none taillabel="1" headlabel="1..*" labeldistance=1.8];
StockItem -> Reservation [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
Order -> PaymentEvent [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
Order -> RefundRequest [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
Order -> IntegrationIntent [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
Order -> AuditEvent [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
RegionalPolicy -> Order [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
StockItem -> ScanEvent [arrowhead=none taillabel="1" headlabel="0..*" labeldistance=1.8];
note [shape=note label="Refund approval limit is derived from RegionalPolicy at approval time (design v2);\nno stored needs_finance value is used for authorization." fontsize=9];
RefundRequest -> note [style=dotted arrowhead=none];
}